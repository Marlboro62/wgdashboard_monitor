{
  "config": {
    "step": {
      "user": {
        "title": "Connect to WGDashboard",
        "data": {
          "host": "Host URL",
          "api_key": "API key",
          "config_name": "WireGuard configuration name",
          "verify_ssl": "Verify SSL certificate"
        },
        "data_description": {
          "host": "Address of WGDashboard, for example http://192.168.1.14:10086",
          "api_key": "WGDashboard → Settings → API Key",
          "config_name": "Usually wg0",
          "verify_ssl": "Turn off only for an HTTPS address with a self-signed certificate"
        }
      },
      "reauth_confirm": {
        "title": "New WGDashboard API key",
        "description": "The API key for {host} was rejected. Create a new one in WGDashboard (Settings → API Key).",
        "data": {
          "api_key": "API key"
        }
      }
    },
    "error": {
      "cannot_connect": "Failed to connect. Check the host URL.",
      "invalid_auth": "The API key was rejected.",
      "invalid_host": "Enter an address starting with http:// or https://"
    },
    "abort": {
      "already_configured": "This WGDashboard configuration is already set up.",
      "reauth_successful": "The API key was updated."
    }
  },
  "entity": {
    "binary_sensor": {
      "connected": {
        "name": "{peer} connected"
      }
    },
    "sensor": {
      "connected_peers": {
        "name": "Connected peers",
        "state_attributes": {
          "total_peers": {
            "name": "Total peers"
          }
        }
      },
      "last_handshake": {
        "name": "{peer} last handshake",
        "state_attributes": {
          "endpoint": {
            "name": "Endpoint"
          },
          "allowed_ips": {
            "name": "Allowed IPs"
          }
        }
      },
      "data_received": {
        "name": "{peer} data received"
      },
      "data_sent": {
        "name": "{peer} data sent"
      }
    }
  }
}
